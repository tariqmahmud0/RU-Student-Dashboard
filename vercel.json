{
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "https://eresult.ru.ac.bd:9603/api/:path*"
    },
    {
      "source": "/api/ru-profile/:path*",
      "destination": "https://profile.ru.ac.bd/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
